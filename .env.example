# QQ 邮箱账号与授权码
JINCHAO_EMAIL_USER=your-email@example.com
JINCHAO_EMAIL_PASS=your-qq-mail-app-password

# 会话密钥（必填，建议用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成）
JINCHAO_SESSION_SECRET=your-32-byte-hex-secret

# 服务端口（选填，默认 3000）
JINCHAO_PORT=3000

# 站点管理员邮箱（选填，接收举报通知）
JINCHAO_ADMIN_EMAIL=admin@example.com
