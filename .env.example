# ===== 烬潮 环境变量模板 =====
# 使用方法：把本文件复制一份并改名为 .env，再填入你自己的真实值
#   Windows     : copy .env.example .env
#   macOS/Linux : cp .env.example .env
# 注意：程序只读取 .env，本文件仅作配置清单用途；.env 已被 .gitignore 忽略，不会提交

# QQ 邮箱账号与 SMTP 授权码（用于发送注册/登录/重置密码的验证码邮件）
# 授权码不是登录密码，需在 QQ 邮箱「设置 → 账户 → POP3/IMAP/SMTP 服务」中开启后获取
JINCHAO_EMAIL_USER=your-email@foxmail.com
JINCHAO_EMAIL_PASS=your-smtp-authorization-code

# 会话密钥（必填）：用于签名登录会话 Cookie，必须保密，不要提交到仓库
# 生成方式：运行下面这条命令，把输出的 64 位十六进制字符串填到等号右边（不要直接填命令本身）
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JINCHAO_SESSION_SECRET=your-generated-64-character-hex-secret

# 服务端口（选填，默认 3000）
JINCHAO_PORT=3000

# 站点管理员邮箱（选填，用于接收内容举报通知）
JINCHAO_ADMIN_EMAIL=admin@example.com